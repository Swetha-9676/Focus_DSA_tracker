{
  "manifest_version": 3,
  "name": "FOCUS",
  "version": "1.0",
  "description": "DSA Smart Study Tracker",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "idle",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "https://leetcode.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],

  "action": {
    "default_popup": "index.html",
    "default_title": "FOCUS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}